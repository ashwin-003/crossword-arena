# Copy this file to .env.local (git-ignored) and fill in your Supabase
# project's own values — never commit real credentials.
#
# Find these under Project Settings -> API in the Supabase dashboard, or via
# `supabase status` when running the local dev stack (see README.md).

# Public — safe to ship to the browser. RLS is what actually protects data.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ---------------------------------------------------------------------------
# The variables below are for Edge Functions ONLY (supabase/functions/*).
# They run server-side and are configured as Supabase Function secrets
# (`supabase secrets set ...`), never as VITE_-prefixed client env vars, and
# must never be bundled into the frontend.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY
